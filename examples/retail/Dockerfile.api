#
# Build from the repository root: requirements.txt installs the seven local packages
# in editable mode, and the API resolves skills/data relative to that root.
#   docker build -f examples/retail/Dockerfile.api .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_TIMEOUT=120 \
    PIP_RETRIES=10

# Default to a mainland-friendly mirror; override with --build-arg PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /repo

# pip needs only requirements.txt and the seven local package dirs. Keep examples/
# out of this layer so edits to demo data/web apps never re-download PyPI.
COPY requirements.txt ./
COPY commerce-common ./commerce-common
COPY shopping-agent ./shopping-agent
COPY merchant-agent ./merchant-agent

# --break-system-packages is safe inside the isolated container and keeps this working
# if the base image ever ships a PEP 668 externally-managed Python.
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY examples ./examples

# uvicorn defaults to 127.0.0.1; bind to all interfaces so the port can be published.
EXPOSE 8000

CMD ["uvicorn", "retail.api.main:app", "--app-dir", "examples", "--host", "0.0.0.0", "--port", "8000"]
