#
# Build from the repository root: requirements.txt installs the seven local packages
# in editable mode, and the API resolves skills/data relative to that root.
#   docker build -f examples/retail/Dockerfile.api .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /repo

COPY requirements.txt ./
COPY commerce-common ./commerce-common
COPY shopping-agent ./shopping-agent
COPY merchant-agent ./merchant-agent
COPY examples ./examples

RUN pip install --no-cache-dir -r requirements.txt

# uvicorn defaults to 127.0.0.1; bind to all interfaces so the port can be published.
EXPOSE 8000

CMD ["uvicorn", "retail.api.main:app", "--app-dir", "examples", "--host", "0.0.0.0", "--port", "8000"]
